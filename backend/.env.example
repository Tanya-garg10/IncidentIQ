# Pick ONE of the following providers. The first key found wins.
# If none are set, IncidentIQ falls back to its built-in rule-based engine.

# Groq (recommended: free + fast). Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI. Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini. Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: force a specific provider regardless of which keys are present.
# Values: groq | openai | gemini
# LLM_PROVIDER=groq
